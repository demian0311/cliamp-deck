# pacman-key --populate is the whole reason this package exists: it imports
# /usr/share/pacman/keyrings/cliamp-deck.gpg and locally signs whatever
# cliamp-deck-trusted lists — both files GENERATED by arch-repo.yml at build
# time, never committed (see the PKGBUILD header and packaging/arch/README.md).
#
# 🔴 @CLIAMP_DECK_KEY_FINGERPRINT@ below is a placeholder. arch-repo.yml
# sed-replaces it with the fingerprint of the key imported from the
# ARCH_SIGNING_KEY secret, the same fingerprint written into
# cliamp-deck-trusted in the same CI step — so the two can never disagree.
# Building by hand: replace it yourself before running makepkg.

post_install() {
  pacman-key --populate cliamp-deck
  /usr/share/cliamp-deck-keyring/ensure-repo.sh
  # 🔴 The right command DIFFERS BY DISTRIBUTION, so this asks the machine
  # rather than printing one answer and being wrong half the time.
  #
  # `-Sy <pkg>` is the partial upgrade Arch warns against, so plain Arch gets
  # `-Syu`. But Omarchy ships /usr/share/libalpm/hooks/00-omarchy-update-guard.hook,
  # which ABORTS any pacman run carrying both -S and -u, telling the user to run
  # `omarchy update` instead — so `-Syu` is not merely inadvisable there, it is
  # refused.
  #
  # The `y` is not optional either way: adding a repository does not FETCH its
  # database, and nothing here can do it — this scriptlet runs inside a
  # transaction already holding the pacman lock.
  if [ -x /usr/bin/omarchy-update-pacman-guard ]; then
    cat <<'MSG'

  The [cliamp-deck] channel is ready. Install the CLI with:

      sudo pacman -Sy cliamp-deck

  The y matters: it downloads this channel's database, which adding the
  repository does not do on its own. Omarchy refuses a direct `pacman -Syu`,
  so keep the system itself current with `omarchy update` as usual.

  Removing this package takes the key and the repository back out again.

MSG
  else
    cat <<'MSG'

  The [cliamp-deck] channel is ready. Install the CLI with:

      sudo pacman -Syu cliamp-deck

  The y matters: it downloads this channel's database, which adding the
  repository does not do on its own.

  After that cliamp-deck upgrades with the rest of the system through
  pacman -Syu. Removing this package takes the key and the repository back
  out again.

MSG
  fi
}

post_upgrade() {
  # Idempotent, and it has to run on an upgrade too: this is the path that
  # re-trusts a rotated key, since the new public half arrives in the package.
  pacman-key --populate cliamp-deck
  /usr/share/cliamp-deck-keyring/ensure-repo.sh
}

pre_remove() {
  /usr/share/cliamp-deck-keyring/ensure-repo.sh --remove
  # --delete takes the key out of pacman's own keyring. Deliberately not
  # guarded: if the key is already gone, pacman-key says so and the removal
  # carries on, which is better than a package that cannot be uninstalled.
  pacman-key --delete @CLIAMP_DECK_KEY_FINGERPRINT@ || true
}
